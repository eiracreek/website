---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main>
    <section
      style="min-height:80vh; display:flex; flex-direction:column; justify-content:center; align-items:center; text-align:center; padding:2rem;"
    >
      <h1 style="font-size:4rem; margin-bottom:0.5rem;">
        Eira Creek
      </h1>

      <p style="font-size:1.5rem; max-width:700px;">
        Preserving and advancing the Golden Guernsey goat through thoughtful breeding,
        education, and stewardship.
      </p>

      <p style="margin-top:3rem; opacity:.7;">
        Our website is currently being prepared for the Oregon State Fair.
      </p>
    </section>
  </main>
</Layout>