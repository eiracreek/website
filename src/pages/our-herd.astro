---
import Layout from '../layouts/Layout.astro';

const herd = [
	{
		name: 'Vanilla Bean',
		role: 'Foundation Doe',
		description:
			'The exceptionally tiny doeling who came to stay for one afternoon and changed the direction of Eira Creek.',
		image: '/images/hero-goat.jpg',
	},
	{
		name: 'Ginger',
		role: 'Doe',
		description:
			'One of Vanilla Bean’s triplet daughters and a member of the original Spice Girls.',
		image: '/images/hero-goat.jpg',
	},
	{
		name: 'Saffron',
		role: 'Doe',
		description:
			'One of Vanilla Bean’s triplet daughters and a member of the original Spice Girls.',
		image: '/images/hero-goat.jpg',
	},
	{
		name: 'Cinnamon',
		role: 'Doe',
		description:
			'One of Vanilla Bean’s triplet daughters and a member of the original Spice Girls.',
		image: '/images/hero-goat.jpg',
	},
];
---

<Layout
	title="Our Herd | Eira Creek"
	description="Meet the Golden Guernsey goats at Eira Creek and learn about the care, breeding goals, and relationships behind our herd."
>
	<header class="page-hero">
		<div class="container page-hero-content">
			<p class="eyebrow">Our Herd</p>

			<h1>Raised With Purpose. Loved Every Day.</h1>

			<p class="lead">
				Our herd reflects our commitment to raising healthy, productive, structurally
				correct Golden Guernseys while preserving the temperament and breed character
				that make them so special.
			</p>
		</div>
	</header>

	<section class="section">
		<div class="container herd-introduction">
			<div>
				<p class="eyebrow">Our Approach</p>
				<h2>Thoughtful breeding begins with knowing each animal well.</h2>
			</div>

			<div>
				<p class="lead">
					We bottle-raise every kid from birth and spend time with our goats every day.
					That close relationship allows us to observe their health, structure,
					temperament, habits, and individual personalities as they grow.
				</p>

				<p>
					Our breeding decisions consider pedigree, conformation, dairy qualities,
					health, longevity, temperament, and the needs of the breed as a whole. We aim
					to strengthen each generation while keeping our goats unmistakably Golden
					Guernsey.
				</p>
			</div>
		</div>
	</section>

	<section class="section section-neutral">
		<div class="container">
			<div class="section-heading">
				<p class="eyebrow">Meet the Goats</p>
				<h2>The herd behind Eira Creek</h2>

				<p class="lead">
					These profiles are a starting point. We will continue adding pedigrees,
					registration details, show records, milk records, offspring, and additional
					photographs as the site grows.
				</p>
			</div>

			<div class="herd-grid">
				{
					herd.map((goat) => (
						<article class="goat-card">
							<div class="goat-image">
								<img src={goat.image} alt={`${goat.name}, a Golden Guernsey goat`} loading="lazy" />
							</div>

							<div class="goat-content">
								<p class="goat-role">{goat.role}</p>
								<h3>{goat.name}</h3>
								<p>{goat.description}</p>

								<span class="profile-status">Full profile coming soon</span>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="section breeding-section">
		<div class="container breeding-inner">
			<p class="eyebrow">Our Breeding Goals</p>

			<h2>
				Strengthening the breed without sacrificing the qualities that make it unique.
			</h2>

			<p class="lead">
				We strive to improve health, productivity, longevity, structural correctness, and
				mammary quality while protecting the Golden Guernsey’s moderate size, gentle
				temperament, distinctive coat, and historic character.
			</p>

			<a class="button" href="/contact">Contact Eira Creek</a>
		</div>
	</section>
</Layout>

<style>
	.page-hero {
		padding-block: clamp(7rem, 16vw, 12rem);
		background:
			linear-gradient(rgba(18, 58, 99, 0.72), rgba(18, 58, 99, 0.72)),
			url('/images/hero-goat.jpg') center / cover no-repeat;
		color: white;
	}

	.page-hero-content {
		max-width: 950px;
		text-align: center;
	}

	.page-hero .eyebrow {
		color: var(--color-accent);
	}

	.page-hero h1 {
		color: white;
	}

	.page-hero .lead {
		max-width: 760px;
		margin: 0 auto;
		color: rgba(255, 255, 255, 0.92);
	}

	.herd-introduction {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		gap: clamp(3rem, 8vw, 8rem);
		align-items: start;
	}

	.herd-introduction p:not(.eyebrow) {
		color: var(--color-text-soft);
	}

	.section-heading {
		max-width: 760px;
		margin-bottom: 3rem;
	}

	.herd-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2rem;
	}

	.goat-card {
		overflow: hidden;
		border: 1px solid rgba(18, 58, 99, 0.12);
		border-radius: var(--radius-large);
		background: white;
		box-shadow: var(--shadow-soft);
	}

	.goat-image {
		height: 360px;
		overflow: hidden;
	}

	.goat-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 300ms ease;
	}

	.goat-card:hover .goat-image img {
		transform: scale(1.03);
	}

	.goat-content {
		padding: 2rem;
	}

	.goat-role {
		margin-bottom: 0.5rem;
		color: var(--color-primary);
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.15em;
		text-transform: uppercase;
	}

	.goat-content h3 {
		margin-bottom: 0.75rem;
	}

	.goat-content p:not(.goat-role) {
		color: var(--color-text-soft);
	}

	.profile-status {
		display: inline-block;
		margin-top: 0.75rem;
		color: var(--color-dark);
		font-size: 0.85rem;
		font-weight: 700;
	}

	.breeding-section {
		background: var(--color-dark);
		color: white;
	}

	.breeding-inner {
		max-width: 900px;
		text-align: center;
	}

	.breeding-section .eyebrow {
		color: var(--color-accent);
	}

	.breeding-section h2 {
		color: white;
	}

	.breeding-section .lead {
		color: rgba(255, 255, 255, 0.86);
	}

	.breeding-section .button {
		margin-top: 1.5rem;
		background: var(--color-accent);
		color: var(--color-dark);
	}

	@media (max-width: 800px) {
		.herd-introduction,
		.herd-grid {
			grid-template-columns: 1fr;
		}

		.goat-image {
			height: 320px;
		}
	}
</style>